@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
    var error = ViewData["Error"] as bool? == true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Acceso · Pedidos Pendientes · Almacén</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .login-wrap {
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
            padding: 24px;
            background:
                radial-gradient(1200px 600px at 100% -10%, rgba(0,164,223,.10), transparent 60%),
                radial-gradient(900px 500px at -10% 110%, rgba(8,119,189,.10), transparent 55%),
                var(--background);
        }
        .login-card {
            width: 100%; max-width: 400px; background: var(--surface);
            border: 1px solid var(--border); border-radius: var(--radius);
            box-shadow: var(--shadow); padding: 32px 30px;
        }
        .login-brand { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
        .login-brand img { height: 46px; width: auto; }
        .login-brand .t { font-weight: 700; color: var(--foreground); line-height: 1.2; }
        .login-brand .s { display: block; font-weight: 400; font-size: 12.5px; color: var(--muted-2); }
        .login-card h1 { font-size: 19px; margin: 6px 0 4px; color: var(--foreground); }
        .login-card p.lead { margin: 0 0 20px; color: var(--muted-2); font-size: 14px; }
        .login-card label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--foreground); }
        .login-card input[type=password] {
            width: 100%; padding: 11px 13px; font-size: 15px;
            border: 1px solid var(--border); border-radius: 10px; background: #fff; color: var(--foreground);
        }
        .login-card input[type=password]:focus { outline: 2px solid var(--primary); outline-offset: 1px; }
        .login-card button {
            width: 100%; margin-top: 16px; padding: 12px 16px; font-size: 15px; font-weight: 600;
            color: #fff; background: var(--primary); border: 0; border-radius: 10px; cursor: pointer;
        }
        .login-card button:hover { background: var(--primary-dark); }
        .demo-pill {
            display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .04em;
            color: var(--primary-dark); background: var(--primary-light);
            border: 1px solid #cbe8fa; padding: 3px 9px; border-radius: 999px; margin-bottom: 14px;
        }
        .login-err {
            margin: 0 0 16px; padding: 10px 13px; font-size: 13.5px;
            color: var(--danger); background: var(--danger-light);
            border: 1px solid #f6cccc; border-radius: 10px;
        }
        .login-foot { margin-top: 18px; font-size: 12px; color: var(--muted); text-align: center; }
    </style>
</head>
<body>
    <div class="login-wrap">
        <div class="login-card">
            <div class="login-brand">
                <img src="~/img/logo-huf.png" alt="Hospital Universitario de Fuenlabrada" />
                <span class="t">Pedidos Pendientes<span class="s">Servicio de Suministros · HUF</span></span>
            </div>

            <span class="demo-pill">ENTORNO DEMO</span>
            <h1>Acceso</h1>
            <p class="lead">Introduce la contraseña para probar la aplicación.</p>

            @if (error)
            {
                <div class="login-err" role="alert">Contraseña incorrecta. Inténtalo de nuevo.</div>
            }

            <form method="post" action="/acceso">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" autocomplete="current-password" autofocus required />
                <button type="submit">Entrar</button>
            </form>

            <p class="login-foot">Datos ficticios · Entorno de demostración</p>
        </div>
    </div>
</body>
</html>
