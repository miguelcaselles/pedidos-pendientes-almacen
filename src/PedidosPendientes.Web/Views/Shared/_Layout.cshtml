@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · Pedidos Pendientes · Almacén</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="brand">
            <img src="~/img/logo-huf.png" alt="Hospital Universitario de Fuenlabrada" />
            <div class="titles">
                <span class="app-title">Pedidos Pendientes · Almacén</span>
                <span class="app-sub">Servicio de Suministros · Hospital Universitario de Fuenlabrada</span>
            </div>
            <div class="spacer"></div>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <span class="user">@User.Identity.Name</span>
            }
        </div>
    </header>

    <nav class="nav-tabs">
        <ul>
            <li><a class="@Active("Orders")" asp-controller="Orders" asp-action="Index">Pedidos</a></li>
            <li><a class="@Active("Carga")" asp-controller="Carga" asp-action="Index">Cargar Excel</a></li>
        </ul>
    </nav>

    <div class="container">
        <main role="main">
            @if (TempData["Success"] is string ok)
            {
                <div class="alert alert-success">@ok</div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger">@err</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div>Hospital Universitario de Fuenlabrada · Servicio de Suministros (Almacén) · SERMAS</div>
        <div>Herramienta de gestión interna. Información de uso restringido y confidencial (RGPD / LOPDGDD).</div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
