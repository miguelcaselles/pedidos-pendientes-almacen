@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string? Current(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    var isDemo = Context.Items["DemoMode"] as bool? == true;
    var isDemoPersistente = Context.Items["DemoPersistente"] as bool? == true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · Pedidos Pendientes · Almacén</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <header class="site-header">
        <div class="brand">
            <img src="~/img/logo-huf.png" alt="Hospital Universitario de Fuenlabrada" />
            <div class="titles">
                <span class="app-title">Pedidos Pendientes <span>· Almacén</span></span>
                <span class="app-sub">Servicio de Suministros · Hospital Universitario de Fuenlabrada</span>
            </div>
            <div class="spacer"></div>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <span class="user">@User.Identity.Name</span>
            }
        </div>
    </header>

    <nav class="nav-tabs" aria-label="Navegación principal">
        <ul>
            <li><a class="@Active("Home")" aria-current="@Current("Home")" asp-controller="Home" asp-action="Index"><span class="nav-icon" aria-hidden="true">⌂</span>Panel</a></li>
            <li><a class="@Active("Orders")" aria-current="@Current("Orders")" asp-controller="Orders" asp-action="Index"><span class="nav-icon" aria-hidden="true">≡</span>Pedidos</a></li>
            <li><a class="@Active("Semaforo")" aria-current="@Current("Semaforo")" asp-controller="Semaforo" asp-action="Index"><span class="nav-icon" aria-hidden="true">◉</span>Semáforo MD04</a></li>
            <li><a class="@Active("Proveedores")" aria-current="@Current("Proveedores")" asp-controller="Proveedores" asp-action="Index"><span class="nav-icon" aria-hidden="true">◇</span>Proveedores</a></li>
            <li><a class="@Active("Estadisticas")" aria-current="@Current("Estadisticas")" asp-controller="Estadisticas" asp-action="Index"><span class="nav-icon" aria-hidden="true">∿</span>Estadísticas</a></li>
            <li><a class="@Active("Catalogo")" aria-current="@Current("Catalogo")" asp-controller="Catalogo" asp-action="Index"><span class="nav-icon" aria-hidden="true">☰</span>Catálogo</a></li>
            <li><a class="@Active("Carga")" aria-current="@Current("Carga")" asp-controller="Carga" asp-action="Index"><span class="nav-icon" aria-hidden="true">↑</span>Cargas</a></li>
            <li><a class="@Active("Configuracion")" aria-current="@Current("Configuracion")" asp-controller="Configuracion" asp-action="Index"><span class="nav-icon" aria-hidden="true">⚙</span>Configuración</a></li>
        </ul>
    </nav>

    @if (isDemo)
    {
        <aside class="demo-banner" aria-label="Aviso de demostración">
            <div class="demo-banner-inner">
                <span class="demo-badge">DEMO</span>
                @if (isDemoPersistente)
                {
                    <span><strong>Entorno de revisión</strong> · Los datos proceden de los listados cargados en «Carga de datos» y se conservan entre sesiones. No es el sistema corporativo: no envía reclamaciones reales.</span>
                }
                else
                {
                    <span><strong>Entorno de demostración</strong> · Todos los nombres, pedidos y contactos son ficticios. Los cambios son temporales y se restauran al reiniciar.</span>
                }
            </div>
        </aside>
    }

    <div class="container">
        <main id="main-content" tabindex="-1">
            @if (TempData["Success"] is string ok)
            {
                <div class="alert alert-success" role="status" data-autodismiss>@ok</div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger" role="alert">@err</div>
            }
            @if (TempData["Mailto"] is string mailto)
            {
                <div class="alert alert-success" role="status">
                    <a href="@mailto" id="mailto-borrador">Abrir el borrador de la reclamación en el correo</a>
                    <span class="muted">(si Outlook no se abrió solo, pulsa el enlace)</span>
                </div>
                <script>
                    // Abre el cliente de correo del puesto con el borrador; el enlace
                    // visible queda como respaldo si el navegador bloquea la apertura.
                    window.addEventListener('DOMContentLoaded', function () {
                        window.location.href = document.getElementById('mailto-borrador').href;
                    });
                </script>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div>Hospital Universitario de Fuenlabrada · Servicio de Suministros (Almacén) · SERMAS</div>
        <div>@(isDemoPersistente
            ? "Entorno de revisión con datos de prueba. Información de uso restringido y confidencial (RGPD / LOPDGDD)."
            : isDemo
                ? "Demostración con información exclusivamente ficticia."
                : "Herramienta de gestión interna. Información de uso restringido y confidencial (RGPD / LOPDGDD).")</div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
