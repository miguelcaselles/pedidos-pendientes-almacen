@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card" style="max-width:640px;margin:40px auto;text-align:center">
    <h1 class="page-title">Se ha producido un error</h1>
    <p class="page-sub">
        No se pudo completar la operación. Vuelve a intentarlo; si el problema persiste,
        anota el identificador y contacta con el responsable de la aplicación.
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Identificador de la petición: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al panel</a>
</div>
